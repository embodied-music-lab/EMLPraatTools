__pycache__/
*.pyc
*.pyo
.DS_Store
*.swp
praat_prefs/

# Scratch preference directories written by the harnesses. Never read by a
# check -- they exist only so a run cannot inherit, or disturb, the user's
# own Praat preferences. harness/record/roundtrip.sh needs this because
# prefs5 decides the output encoding, and an inherited one made that harness
# pass five times and then fail.
harness/*/prefs/
harness/stress_cases/prefs/

# Probe output written beside a probe when it is run BY HAND. The drivers
# set EML_OUT; the fallback is the current folder, deliberately, so that a
# hand-run can never write into another tree -- but it must not be committed.
harness/disclosure/formpath_*.png
harness/disclosure/worst_*.png
harness/determinism/prefs/
# The parity harness writes a scratch pref dir, same as the others.
harness/parity/prefs/
# The wrapper parse harness writes a scratch pref dir and per-wrapper logs.
# WRAPPERS.tsv is the evidence validate/v35 reads and is NOT ignored.
harness/wrappers/prefs/
harness/wrappers/out/*.log
# The GUI end-to-end harness writes a scratch pref dir and per-run logs.
# DIALOGS.tsv is the evidence validate/v35 reads and is NOT ignored.
harness/gui_e2e/prefs/
harness/gui_e2e/out/*.log
harness/gui_e2e/out/*.png
# The record end-to-end harness writes a scratch pref dir and a driver log.
# RECORD.tsv and the emitted script ARE the evidence and are NOT ignored.
harness/record_e2e/prefs/
harness/record_e2e/out/driver.log
# The form-helper harness plants collision bait -- empty files whose only
# purpose is to already exist when @emlGenerateUniquePath is asked for a
# name. run.sh rebuilds the tree from nothing on every run, because a
# leftover file would change what "already taken" means and quietly move
# every answer. FORMHELPERS.tsv and the driver log ARE the evidence and are
# NOT ignored.
harness/formhelpers/out/scratch/
# The tab-walk probe's raw Praat transcript. TABWALK_JOINED.tsv is the
# evidence validate/v44 reads and is NOT ignored.
harness/tabwalk/out/*.log
# The gui end-to-end run's own HOME. It is pointed inside out/ so a run cannot
# write its figure into the real home directory -- which it did on 13 Aug 2026,
# because @emlSaveConfig had persisted lastPNGFolder there. The figure and CSV
# land in it; ARTEFACTS.tsv records their names and sizes and IS the evidence.
harness/gui_e2e/out/home/

# harness/savepaths: the EVIDENCE is DIALOGS.tsv, ARTEFACTS.tsv, PANEL.png and
# the files each save wrote. Everything below is session state that changes on
# every run and says nothing about the plugin: Praat's own instance lock, the
# scratch pref dir, and the X server and window manager logs. Committing them
# makes every run a diff and buries the four files that matter.
harness/savepaths/prefs/
harness/savepaths/out/*/home/.praat-dir/
harness/savepaths/out/xvfb.log
harness/savepaths/out/wm.log
