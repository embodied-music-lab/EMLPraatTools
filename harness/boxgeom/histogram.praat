include fixture.praat
# THE HISTOGRAM. The bins tile the whole value axis, so the first and last bin
# edges are the left and right edges of the frame, and every bar stands on a
# frequency of zero, which is the bottom. The tallest bar is short of the
# frequency axis's top, so top is not claimed.
@bgSetType: 10
@bgPress
@bgSave: "left right bottom"
