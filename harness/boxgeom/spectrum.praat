include fixture.praat
# THE SPECTRUM. The frequency axis is the object's own domain, 0 to Nyquist,
# so the curve spans the frame from edge to edge. The power axis bottoms out
# at the minimum power in the spectrum, which is the frame's lower edge.
# The peak is below the top of the axis, so top is not claimed.
@bgSetType: 3
@bgPress
@bgSave: "left right bottom"
