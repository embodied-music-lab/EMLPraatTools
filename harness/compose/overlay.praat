include fixture.praat
# TWO DRAWS AT THE SAME ORIGIN WITH ERASE OFF. Permitted by author ruling,
# however it looks: a compositor who points two panels at one origin is doing
# manual layout and owns the result.
@composePanel: 11, 0, 0, 1, 1, "First"
@composePanel: 12, 0, 0, 0, 1, "Second over first"
@composeSave
