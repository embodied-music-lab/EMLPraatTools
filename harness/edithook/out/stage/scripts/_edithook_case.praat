# Driver for case G_quote. Generated by harness/edithook/run.sh.
include ../stats/eml-record.praat
runScript: "eml-record-start.praat"
Create Table with column names: "demo", 3, "id f0"
tableId = selected ("Table")
for r to 3
    selectObject: tableId
    Set string value: r, "id", "S" + string$ (r)
    Set string value: r, "f0", "10" + string$ (r)
endfor
selectObject: tableId
Save as comma-separated file: "/home/claude/repo/harness/edithook/out/G_quote_before.csv"
appendInfoLine: "CASE handoff"
selectObject: tableId
runScript: "edithook_twin.praat", "editor"
appendInfoLine: "CASE returned"
selectObject: tableId
Save as comma-separated file: "/home/claude/repo/harness/edithook/out/G_quote_after.csv"
nSteps = 0
nocheck selectObject: "Table emlRecording_DO_NOT_REMOVE"
if numberOfSelected () = 1
    bufId = selected ("Table")
    nSteps = Get number of rows
    for i to nSteps
        selectObject: bufId
        k$ = Get value: i, "kind"
        it$ = Get value: i, "intent"
        cd$ = Get value: i, "code"
        sr$ = Get value: i, "source"
        appendInfoLine: "STEP|", i, "|", k$, "|", sr$, "|", it$
        appendInfoLine: "CODE<<<"
        appendInfoLine: cd$
        appendInfoLine: "CODE>>>"
    endfor
endif
appendInfoLine: "CASE steps|", nSteps
@emlRecordFlush: "/home/claude/repo/harness/edithook/out/G_quote_rec.praat"
appendInfoLine: "CASE done"
