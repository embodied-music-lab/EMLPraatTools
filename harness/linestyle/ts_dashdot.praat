include fixture.praat
# DASHED-DOTTED. The pen a run-length measurement has to work hardest to tell
# from Dashed: its long runs are the dashes and its short ones are the dots, so
# the two styles differ in the SHAPE of the run distribution and not only in
# how much ink is on the page.
@lsSetType: 5
tsLineStyle = 4
@lsPress
@lsReport: 4
@lsSave
