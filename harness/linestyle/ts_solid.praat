include fixture.praat
# THE PEN AT ITS DEFAULT, said out loud. Solid is what every line this plugin
# drew before this change order, so this figure is the control the other three
# styles are measured against -- and the file the reset cases must reproduce
# byte for byte.
@lsSetType: 5
tsLineStyle = 1
@lsPress
@lsReport: 1
@lsSave
