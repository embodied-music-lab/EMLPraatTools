# --- Step 2 (draw) ---
selectObject: data2$
data = selected ()
# Box plot: City B
# Whisker convention and outlier rule are stated in the figure, not assumed.

@emlDrawBoxPlot: data, "City B", "Ward", "n", 6, 4, "color", 1, groupCol2$, valueCol2$, axisYMin2, axisYMax2

