include fixture.praat
# THE FIGURE THE FEATURE EXISTS FOR: two series on two scales, one draw.
# F0 in hertz on the left, contact quotient as a proportion on the right,
# auto range on both. Solid left, dashed right, slot one and slot two.
emlSecondAxisOn = 1
emlSecondAxisCol$ = "cq"
emlSecondAxisMin = 0
emlSecondAxisMax = 0
emlSecondAxisLabel$ = "Contact quotient"
emlSecondAxisStyle = 3
@emlGraphsDrawWithLegendRoom
@secondReport
@secondSave
