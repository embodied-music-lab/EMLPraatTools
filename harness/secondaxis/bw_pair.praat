include fixture.praat
# THE SAME FIGURE IN BLACK AND WHITE, which is the mode the ruling is really
# about: the two series take the two ends of the grey ramp, and STYLE is what
# still tells them apart on a page that has no hue in it at all.
colorMode$ = "bw"
emlSecondAxisOn = 1
emlSecondAxisCol$ = "cq"
emlSecondAxisLabel$ = "Contact quotient"
emlSecondAxisStyle = 3
@emlGraphsDrawWithLegendRoom
@secondReport
@secondSave
