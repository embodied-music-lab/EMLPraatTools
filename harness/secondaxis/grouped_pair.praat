include fixture.praat
# A GROUPED PRIMARY WITH A RIGHT-HAND SERIES. Two singers on the left, the
# contact quotient on the right, and the key names all three -- the right-hand
# entry tagged "(right axis)" and drawn with its own pen, which is what makes
# the key a description of the figure rather than of the data.
groupColName$ = "g"
y_axis_label$ = "F0 (Hz)"
emlSecondAxisOn = 1
emlSecondAxisCol$ = "cq"
emlSecondAxisLabel$ = "Contact quotient"
emlSecondAxisStyle = 3
@emlGraphsDrawWithLegendRoom
@secondReport
@secondSave
