include fixture.praat
# THE PENS, BOTH OF THEM, NEITHER AT ITS DEFAULT. The primary is dotted and
# the second series is dashed-dotted, which is the statement that each series
# carries its OWN style option and that the second is not a hardcoded partner
# of the first.
emlLineStyle = 2
emlSecondAxisOn = 1
emlSecondAxisCol$ = "cq"
emlSecondAxisLabel$ = "Contact quotient"
emlSecondAxisStyle = 4
@emlGraphsDrawWithLegendRoom
@secondReport
@secondSave
